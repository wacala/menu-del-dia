#!/usr/bin/env bash
set -e
BACKEND_DIR="$(cd "$(dirname "$0")/../backend" && pwd)"
MOBILE_DIR="$(cd "$(dirname "$0")/../mobile" && pwd)"

echo ""
echo "  ╔══════════════════════════════════════╗"
echo "  ║      🍽️  Menú del Día — Start       ║"
echo "  ╚══════════════════════════════════════╝"
echo ""

# ── Kill any existing processes ──
echo "🔧 Limpiando procesos anteriores..."
lsof -ti :3001 2>/dev/null | xargs kill -9 2>/dev/null || true
pkill -f "expo start" 2>/dev/null || true
pkill -f "npx expo" 2>/dev/null || true
sleep 1

# ── Start backend ──
echo "🚀 Arrancando backend (puerto 3001)..."
cd "$BACKEND_DIR"
RESEND_API_KEY=re_placeholder node src/server.js &
BACKEND_PID=$!
echo "   PID: $BACKEND_PID"

# Wait for backend to be ready
sleep 2
if curl -s --connect-timeout 2 http://localhost:3001/api/health > /dev/null 2>&1; then
  echo "   ✅ Backend listo en http://localhost:3001"
else
  echo "   ⚠️  Backend no responde, revisa logs"
fi

# ── Start Expo ──
echo "📱 Arrancando Expo (con caché limpio)..."
cd "$MOBILE_DIR"
npx expo start -c &
EXPO_PID=$!
echo "   PID: $EXPO_PID"

echo ""
echo "  ╔══════════════════════════════════════╗"
echo "  ║   🟢 Todo listo                     ║"
echo "  ║   Backend :3001                      ║"
echo "  ║   Expo    escanea QR                 ║"
echo "  ╚══════════════════════════════════════╝"
echo ""
echo "   Para detener: pkill -f 'node src/server' && pkill -f 'expo'"
echo ""

# Keep script running so user sees output
wait
