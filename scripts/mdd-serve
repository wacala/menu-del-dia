#!/usr/bin/env bash
set -e
PORT="${PORT:-3001}"
DIR="$(cd "$(dirname "$0")/../backend" && pwd)"

echo "🔧 Liberando puerto $PORT..."
lsof -ti :"$PORT" 2>/dev/null | xargs kill -9 2>/dev/null || true
sleep 1

echo "🚀 Arrancando servidor en 0.0.0.0:$PORT..."
cd "$DIR"
RESEND_API_KEY=re_placeholder node src/server.js
